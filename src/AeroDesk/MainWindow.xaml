<Window x:Class="AeroDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroDesk"
        Width="900"
        Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="12" CornerRadius="18" Background="#E81B2533" BorderBrush="#80FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#402D5A78" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Margin="20,0" Text="AeroDesk" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White" />
            </Border>
            <Grid Grid.Row="1" Margin="24">
                <Border Width="300" Height="180" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="24" CornerRadius="14" Background="#BFFFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CLOCK WIDGET" FontSize="12" FontWeight="Bold" Foreground="#B0FFFFFF" />
                        <TextBlock x:Name="ClockText" Margin="0,12,0,0" FontSize="42" FontWeight="Light" Foreground="White" />
                        <TextBlock x:Name="DateText" Margin="0,4,0,0" FontSize="15" Foreground="#D0FFFFFF" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Widget host + launcher coming next..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#A0FFFFFF" />
            </Grid>
        </Grid>
    </Border>
</Window>
