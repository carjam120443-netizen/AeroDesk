<Window x:Class="AeroDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AeroDesk.Widgets"
        Title="AeroDesk" Width="900" Height="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Border Margin="12" CornerRadius="18" Background="#E81B2533" BorderBrush="#80FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#402D5A78" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Margin="20,0" Text="AeroDesk" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
            </Border>
            <widgets:WidgetHost x:Name="WidgetHost" Grid.Row="1" Margin="24"/>
        </Grid>
    </Border>
</Window>
