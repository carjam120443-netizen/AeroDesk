<Window x:Class="AeroDesk.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:widgets="clr-namespace:AeroDesk.Widgets"
 Title="AeroDesk" Width="1000" Height="650" WindowStartupLocation="CenterScreen"
 Background="Transparent" WindowStyle="None" AllowsTransparency="True">
 <Border Margin="8" CornerRadius="12" BorderThickness="1" BorderBrush="#BFE8F7FF" Background="#E51B5E87">
  <Border.Effect><DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.55"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
   <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#D9297FB8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <DockPanel Margin="16,0">
     <TextBlock Text="✦ AeroDesk" FontSize="24" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
      <Button Content="+ Add Widget" Click="AddWidget_Click" Margin="4" Padding="14,7"/>
      <Button Content="Themes" Click="Theme_Click" Margin="4" Padding="14,7"/>
      <Button Content="—" Click="Minimize_Click" Margin="4" Padding="12,7"/>
      <Button Content="×" Click="Close_Click" Margin="4" Padding="12,7"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1">
    <widgets:WidgetHost x:Name="WidgetHost" Margin="20"/>
    <Border x:Name="WidgetMenu" Width="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Padding="12" CornerRadius="10" Background="#F2204D6D" BorderBrush="#CCFFFFFF" BorderThickness="1" Visibility="Collapsed">
     <StackPanel>
      <TextBlock Text="ADD A WIDGET" FontWeight="Bold" Foreground="White" Margin="6"/>
      <Button Content="🕒 Clock" Click="AddClock_Click" Margin="4"/>
      <Button Content="📅 Date &amp; Calendar (coming soon)" IsEnabled="False" Margin="4"/>
      <Button Content="💻 System Monitor (coming soon)" IsEnabled="False" Margin="4"/>
      <Button Content="🌐 Network (coming soon)" IsEnabled="False" Margin="4"/>
      <Button Content="📝 Notes (coming soon)" IsEnabled="False" Margin="4"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>