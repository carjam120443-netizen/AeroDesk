<Window x:Class="AeroDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:AeroDesk.Widgets"
        Title="AeroDesk Manager"
        Width="1000" Height="650"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="True">
    <Border Margin="8" CornerRadius="14" BorderThickness="1" BorderBrush="#CFFFFFFF" Background="#C92873A6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="#D9348BC5" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,0">
                    <TextBlock Text="✦ AeroDesk Manager" FontSize="24" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="+ Add Widget" Click="AddWidget_Click" Margin="4" Padding="14,7"/>
                        <Button Content="Themes" Click="Theme_Click" Margin="4" Padding="14,7"/>
                        <Button Content="Widgets on Desktop ✓" Click="WidgetsDesktop_Click" Margin="4" Padding="14,7"/>
                        <Button Content="—" Click="Minimize_Click" Margin="4" Padding="12,7"/>
                        <Button Content="×" Click="Close_Click" Margin="4" Padding="12,7"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <StackPanel Margin="24">
                    <TextBlock Text="AeroDesk Manager" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Margin="0,8,0,20" Text="Manage your Aero widgets while they live directly on the Windows desktop." FontSize="16" Foreground="#D8FFFFFF" TextWrapping="Wrap"/>
                    <Border Padding="18" CornerRadius="12" Background="#7025557A" BorderBrush="#80FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="DESKTOP WIDGETS" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Margin="0,8,0,0" Text="Widgets are separate windows now, so this manager can be moved, minimized, or placed anywhere without dragging the widgets with it." Foreground="#D8FFFFFF" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border x:Name="WidgetMenu" Width="280" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Padding="12" CornerRadius="10" Background="#F225557A" BorderBrush="#CCFFFFFF" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ADD A WIDGET" FontWeight="Bold" Foreground="White" Margin="6"/>
                        <Button Content="🕒 Clock" Click="AddClock_Click" Margin="4"/>
                        <Button Content="💻 System Monitor" Click="AddSystem_Click" Margin="4"/>
                        <Button Content="🌐 Network" Click="AddNetwork_Click" Margin="4"/>
                        <Button Content="📝 Sticky Notes" Click="AddNotes_Click" Margin="4"/>
                        <Button Content="📅 Date &amp; Calendar" IsEnabled="False" Margin="4"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
