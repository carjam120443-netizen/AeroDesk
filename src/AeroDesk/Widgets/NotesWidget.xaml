<UserControl x:Class="AeroDesk.Widgets.NotesWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="280" MinHeight="180">
 <Border Padding="16" CornerRadius="14" Background="#D9FFF7A8" BorderBrush="#90FFFFFF" BorderThickness="1">
  <StackPanel>
   <TextBlock Text="STICKY NOTE" FontWeight="Bold" Foreground="#70404040"/>
   <TextBox x:Name="NoteText" Margin="0,10,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110" BorderThickness="0" Background="Transparent" Foreground="#303030" FontSize="16" TextChanged="NoteText_TextChanged"/>
  </StackPanel>
 </Border>
</UserControl>
