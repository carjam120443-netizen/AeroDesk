<UserControl x:Class="AeroDesk.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280" MinHeight="160">
    <Border Padding="24" CornerRadius="14" Background="#BFFFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="CLOCK" FontSize="12" FontWeight="Bold" Foreground="#B0FFFFFF" />
            <TextBlock x:Name="ClockText" Margin="0,12,0,0" FontSize="42" FontWeight="Light" Foreground="White" />
            <TextBlock x:Name="DateText" Margin="0,4,0,0" FontSize="15" Foreground="#D0FFFFFF" />
        </StackPanel>
    </Border>
</UserControl>
